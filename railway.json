{
  "build": {
    "builder": "NIXPACKS",
    "buildEnv": {
      "NODE_VERSION": "20"
    }
  },
  "deploy": {
    "startCommand": "node scripts/initMedia.js && node server.js",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}